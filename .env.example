# ===========================
# 환경 변수 설정 예시 파일
# ===========================
# 이 파일을 .env.local로 복사하고 실제 값으로 수정하세요.
# cp .env.example .env.local

# ===========================
# 데이터베이스 설정
# ===========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_DRIVER=org.postgresql.Driver

# 선택적 데이터베이스 연결 설정
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# 클라이언트에서 사용할 데이터베이스 설정 (보안상 password는 제외)
NEXT_PUBLIC_DB_HOST=localhost
NEXT_PUBLIC_DB_PORT=5432
NEXT_PUBLIC_DB_NAME=postgres
NEXT_PUBLIC_DB_USER=postgres
NEXT_PUBLIC_DB_DRIVER=org.postgresql.Driver
NEXT_PUBLIC_DB_URL=jdbc:postgresql://localhost:5432/postgres

# ===========================
# LLM 제공자 선택 설정
# ===========================
# 방법 1: LLM 환경변수로 선택
LLM=LOCAL    # LOCAL 또는 GEMINI
#LLM=GEMINI

# 방법 2: MODEL 이름으로 자동 감지 (gemini로 시작하면 Gemini API 사용)
MODEL=your_model_name_here        # 예: qwen3-30b-a3b-mlx
#MODEL=sqlcoder-7b-2             # LM Studio 사용

# Google Gemini 모델들 (https://ai.google.dev/gemini-api/docs/models)
#MODEL=gemini-2.5-flash         # Gemini API 사용
#MODEL=gemini-2.5-flash-lite-preview-06-17  # Gemini API 사용

# ===========================
# LM Studio 설정 (LOCAL 모드)
# ===========================
LM_STUDIO_URL=http://localhost:1234

# ===========================
# Google Gemini 설정 (GEMINI 모드)
# ===========================
# https://aistudio.google.com/app/apikey 에서 API 키를 발급받으세요
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models

# ===========================
# 기능 제어 설정
# ===========================
THINK=true   # true: <think> 태그 파싱, false: content 바로 리턴
STREAM=true  # true: 스트리밍 활성화, false: 일반 JSON 응답 (Gemini는 스트리밍 미지원)

# ===========================
# API 기본 URL (선택사항)
# ===========================
NEXT_PUBLIC_API_BASE_URL=

# ===========================
# 사용 시나리오 예시
# ===========================
# 
# 1. SQLCoder 빠른 개발 모드:
#    MODEL=sqlcoder-7b-2, THINK=false, STREAM=false
# 
# 2. Qwen 상세 분석 모드:
#    MODEL=qwen3-30b-a3b-mlx, THINK=true, STREAM=true
# 
# 3. Gemini 빠른 모드 (방법 1):
#    LLM=GEMINI, THINK=false, STREAM=false
# 
# 4. Gemini 빠른 모드 (방법 2):
#    MODEL=gemini-2.0-flash, THINK=false, STREAM=false
# 
# 5. Gemini 상세 분석 모드:
#    MODEL=gemini-2.0-flash, THINK=true, STREAM=false (스트리밍 미지원)
# 
# 6. 다른 Gemini 모델 사용:
#    MODEL=gemini-1.5-pro, THINK=true, STREAM=false

# ===========================
# 보안 주의사항
# ===========================
# - 이 파일(.env.local)은 절대 Git에 커밋하지 마세요
# - API 키와 비밀번호는 안전하게 보관하세요
# - 프로덕션 환경에서는 더 강력한 인증 방식을 사용하세요